# Copy to .env and fill in. NEVER commit your real .env.

# Your own Gemini/Antigravity API key (free tier works). Get one at
# https://aistudio.google.com/apikey  -- either name is accepted.
GEMINI_API_KEY=
# AGY_API_KEY=

# Bind address (keep 127.0.0.1 unless you know you want LAN access).
AGY_HOST=127.0.0.1
AGY_PORT=8081

# Optional: require this bearer token on every request (recommended if you bind
# to anything other than localhost). Clients send it as Authorization: Bearer ...
# or x-api-key. Leave blank to disable.
AGY_PROXY_TOKEN=

# Default underlying model when a preset does not pin one.
AGY_DEFAULT_MODEL=gemini-3-pro

# Path to your presets file.
# AGY_PRESETS=./presets.yaml

# Stateful session cache (used when clients send an x-agy-session header).
AGY_SESSION_TTL=900
AGY_SESSION_MAX=64

AGY_LOG_LEVEL=info
