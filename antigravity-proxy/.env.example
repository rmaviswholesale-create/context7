# Copy to .env and fill in. NEVER commit your real .env.

# Your own Gemini/Antigravity API key (free tier works). Get one at
# https://aistudio.google.com/apikey  -- either name is accepted.
GEMINI_API_KEY=
# AGY_API_KEY=

# Bind address (keep 127.0.0.1 unless you know you want LAN access).
AGY_HOST=127.0.0.1
AGY_PORT=8081

# Token clients must send (Authorization: Bearer ... or x-api-key). Leave blank on
# loopback to have one generated and printed at startup. REQUIRED for non-loopback binds
# (which are still unsafe without TLS + firewall; see README Security).
AGY_PROXY_TOKEN=

# Accepted Host header values (comma-separated). Default: loopback names.
# AGY_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]

# Absolute directory that write-capable presets (agy-coder) may work in. Required for them.
# AGY_WORKSPACE=/home/you/projects/sandbox
# Opt in to the agy-coder preset (can edit files and run commands as this user!).
# AGY_ENABLE_CODER=0

# Log the agent's tool calls to the proxy log (never sent to clients).
# AGY_LOG_TOOLS=1

# Default underlying model when a preset does not pin one.
AGY_DEFAULT_MODEL=gemini-3-pro

# Path to your presets file.
# AGY_PRESETS=./presets.yaml

# Stateful session cache (used when clients send an x-agy-session header).
AGY_SESSION_TTL=900
AGY_SESSION_MAX=64

AGY_LOG_LEVEL=info
